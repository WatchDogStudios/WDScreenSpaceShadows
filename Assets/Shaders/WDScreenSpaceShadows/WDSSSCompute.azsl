 *
 * Bend screen-space-shadows compute entry point. The wavefront marching algorithm is the AZSL port of
 * Bend Studio's bend_sss_gpu.h (Apache-2.0, (c) 2023 Sony Interactive Entertainment) - see THIRD_PARTY.md
 * for the list of changes (resources moved to the SRG, depth read via WDSSS_SampleDepth).
 *
 * These four macros configure the ported code and MUST be defined before WDSSSBendShadow.azsli. They are
 * compile-time (SAMPLE_COUNT sizes a groupshared array and drives loop unrolling); tuning the shadow
 * length at runtime would be a supervariant follow-up.
 */

#define WAVE_SIZE 64           // numthreads[WAVE_SIZE,1,1] - Bend is tuned for 64
#define SAMPLE_COUNT 60        // shadow samples per pixel (shadow length, in pixels)
#define HARD_SHADOW_SAMPLES 4  // initial samples that produce a hard (non-averaged) shadow
#define FADE_OUT_SAMPLES 8     // trailing samples that soften the shadow cutoff

#include <WDSSSCommon.azsli>
#include <WDSSSBendShadow.azsli>

[numthreads(WAVE_SIZE, 1, 1)]
void MainCS(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    DispatchParameters params;

    // Per-dispatch runtime values from the CPU (Bend::DispatchList / DispatchData).
    params.LightCoordinate = PassSrg::m_lightCoordinate;
    params.WaveOffset = PassSrg::m_waveOffset;

    // Renderer + sampling values.
    params.InvDepthTextureSize = PassSrg::m_invDepthTextureSize;
    params.FarDepthValue = PassSrg::m_farDepthValue;
    params.NearDepthValue = PassSrg::m_nearDepthValue;

    // Tunables.
    params.SurfaceThickness = PassSrg::m_surfaceThickness;
    params.BilinearThreshold = PassSrg::m_bilinearThreshold;
    params.ShadowContrast = PassSrg::m_shadowContrast;
    params.IgnoreEdgePixels = (PassSrg::m_flags & 1) != 0;
    params.UsePrecisionOffset = (PassSrg::m_flags & 2) != 0;
    params.BilinearSamplingOffsetMode = (PassSrg::m_flags & 4) != 0;

    // Debug visualization, packed into m_flags bits 8-10 by the CPU (r.wdSSSDebugView): 2 = Bend
    // wavefront layout (sanity-checks the light coordinate / sun direction), 3 = raw start-pixel depth.
    // 0/1 = normal shadow.
    const int wdsssDebugMode = (PassSrg::m_flags >> 8) & 0x7;
    params.DebugOutputEdgeMask = false;
    params.DebugOutputThreadIndex = false;
    params.DebugOutputWaveIndex = (wdsssDebugMode == 2);
    params.DebugMode = wdsssDebugMode;
    params.DepthBounds = PassSrg::m_depthBounds;
    params.UseEarlyOut = false;

    WriteScreenSpaceShadow(params, (int3)groupId, (int)groupThreadId.x);
}
