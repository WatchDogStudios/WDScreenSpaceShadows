 *
 * Combines the screen-space shadow mask into Atom's sun-visibility buffer in place: the final value is
 * min(cascade shadow, contact shadow), so the Forward lighting (which reads m_fullscreenShadow) darkens
 * the sun wherever Bend found a contact shadow, with no lighting-shader edits.
 */

#include <Atom/Features/SrgSemantics.azsli>

ShaderResourceGroup PassSrg : SRG_PerPass
{
    Texture2D<float>   m_shadowMask;       // Bend contact-shadow mask (1 = lit, 0 = shadowed)
    RWTexture2D<float> m_fullscreenShadow; // FullscreenShadowBuffer, read-modify-write in place
}

[numthreads(8, 8, 1)]
void MainCS(uint3 dispatchId : SV_DispatchThreadID)
{
    uint width, height;
    PassSrg::m_fullscreenShadow.GetDimensions(width, height);
    if (dispatchId.x >= width || dispatchId.y >= height)
    {
        return;
    }

    const float contact = PassSrg::m_shadowMask.Load(int3(dispatchId.xy, 0)).r;
    const float cascade = PassSrg::m_fullscreenShadow[dispatchId.xy];
    PassSrg::m_fullscreenShadow[dispatchId.xy] = min(cascade, contact);
}
