 *
 * Fullscreen visualization of the screen-space shadow mask (grayscale: white = lit, black = shadowed).
 */

#include <Atom/Features/SrgSemantics.azsli>
#include <Atom/Features/PostProcessing/FullscreenPixelInfo.azsli>
#include <Atom/Features/PostProcessing/FullscreenVertex.azsli>

ShaderResourceGroup PassSrg : SRG_PerPass
{
    Texture2D<float> m_shadowMask;
}

PSOutput MainPS(VSOutput IN)
{
    PSOutput OUT;
    const float shadow = PassSrg::m_shadowMask.Load(int3(IN.m_position.xy, 0)).r;
    OUT.m_color = float4(shadow, shadow, shadow, 1.0);
    return OUT;
}
